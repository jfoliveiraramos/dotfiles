[global]
    monitor = 0    
    follow  = keyboard

    font="JetBrainsMonoNF 11"
    foreground="#ffaf5f"
    background="#000000"
    frame_color="#ffaf5f"

    max_icon_size = 60
    min_icon_size = 60
    text_icon_padding = 10 
    icon_corner_radius = 4

    indicate_hidden = yes
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    width = 400
    height = 90
    offset = 10x10
    corner_radius=5
    padding=11
    horizontal_padding=11
    frame_width=1


[osd]
    summary = "*"
    urgency = low
    match_string = "string:x-dunst-stack-tag:osd"
    origin = bottom-center
    alignment = center
